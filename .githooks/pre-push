#!/bin/sh
# Pre-push safety net: verify commits being pushed contain no leaked secrets.
set -eu

root=$(git rev-parse --show-toplevel)

if ! command -v gitleaks >/dev/null 2>&1; then
    printf 'pre-push: gitleaks not found in PATH; push blocked\n' >&2
    exit 1
fi

gitleaks git --no-banner --redact --config "$root/.gitleaks.toml" "$root"
exit 0
